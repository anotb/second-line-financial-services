{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-line-financial-services/schemas/model-card.schema.json",
  "title": "ModelCard",
  "description": "Firm-side model card for an AI or model use case in financial services. Consumed by board-ai-risk-pack, validation-plan, ai-governance-reviewer, model-inventory and exam-readiness flows.",
  "type": "object",
  "required": [
    "card_metadata",
    "intended_use",
    "data",
    "performance",
    "limitations",
    "monitoring",
    "controls",
    "signoff_questions",
    "source_trace"
  ],
  "additionalProperties": false,
  "properties": {
    "card_metadata": {
      "type": "object",
      "required": ["model_id", "version", "owner", "date", "tier", "lifecycle_stage"],
      "additionalProperties": false,
      "properties": {
        "model_id": { "type": "string", "description": "Canonical firm model ID." },
        "version": { "type": "string" },
        "owner": {
          "type": "object",
          "required": ["model_owner", "model_owner_function"],
          "properties": {
            "model_owner": { "type": "string" },
            "model_owner_function": { "type": "string" },
            "validator": { "type": "string" },
            "second_line_reviewer": { "type": "string" }
          }
        },
        "date": { "type": "string", "format": "date" },
        "tier": {
          "type": "string",
          "enum": ["tier-1", "tier-2", "tier-3", "tier-4", "tier-unassigned"]
        },
        "lifecycle_stage": {
          "type": "string",
          "enum": ["development", "pre-prod", "prod", "monitoring-only", "retirement"]
        },
        "classification": { "type": "string" },
        "use_case_id": { "type": "string", "description": "Links to ai-use-case-intake record." },
        "engagement_scope_id": { "type": "string", "description": "Links to engagement-scoping record if supplied." }
      }
    },
    "intended_use": {
      "type": "object",
      "required": ["purpose", "intended_users", "in_scope_decisions", "out_of_scope_decisions"],
      "properties": {
        "purpose": { "type": "string" },
        "intended_users": { "type": "array", "items": { "type": "string" } },
        "in_scope_decisions": { "type": "array", "items": { "type": "string" } },
        "out_of_scope_decisions": { "type": "array", "items": { "type": "string" } },
        "geographic_scope": { "type": "array", "items": { "type": "string" } },
        "customer_segment_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "model_type": { "type": "string", "description": "e.g., logistic regression, GBM, transformer, prompted LLM, RAG, agent." },
        "foundation_model": {
          "type": "object",
          "properties": {
            "provider": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "string" },
            "version_pinning": {
              "type": "string",
              "enum": ["pinned", "floating", "rolling-with-notice", "unknown"]
            }
          }
        },
        "uses_rag": { "type": "boolean" },
        "rag_corpus": { "type": "array", "items": { "type": "string" } },
        "uses_tools": { "type": "boolean" },
        "tool_inventory": { "type": "array", "items": { "type": "string" } },
        "autonomy_level": {
          "type": "string",
          "enum": ["advisory", "advisory-with-suggested-action", "human-in-the-loop", "human-on-the-loop", "agentic-with-tool-use", "fully-autonomous"]
        },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "purpose", "sensitivity"],
        "properties": {
          "source": { "type": "string" },
          "purpose": {
            "type": "string",
            "enum": ["training", "fine-tuning", "retrieval", "evaluation", "monitoring", "reference"]
          },
          "sensitivity": { "type": "string", "description": "e.g., NPI, PHI, public, confidential business data." },
          "licensing": { "type": "string" },
          "retention": { "type": "string" },
          "lineage": { "type": "string" },
          "exclusions": { "type": "array", "items": { "type": "string" }, "description": "Prohibited rating factors or excluded fields." }
        }
      }
    },
    "performance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "value", "evaluation_set", "date"],
        "properties": {
          "metric": { "type": "string" },
          "value": {},
          "segment": { "type": "string", "description": "Population segment (overall, by FICO band, by region, by line of business, etc.)." },
          "evaluation_set": { "type": "string" },
          "deployed_environment": { "type": "boolean", "description": "True if metric is from the deployed environment, false if lab/holdout only." },
          "date": { "type": "string", "format": "date" },
          "owner": { "type": "string" }
        }
      }
    },
    "robustness_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_name", "method", "result"],
        "properties": {
          "test_name": { "type": "string" },
          "method": { "type": "string" },
          "result": { "type": "string" },
          "owner": { "type": "string" },
          "date": { "type": "string", "format": "date" }
        }
      }
    },
    "fairness_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "metric", "value"],
        "properties": {
          "dimension": { "type": "string", "description": "Protected or policy-relevant dimension." },
          "metric": { "type": "string" },
          "value": {},
          "disparity_assessment": { "type": "string" },
          "method_limitations": { "type": "string" }
        }
      }
    },
    "explainability": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "scope": { "type": "string" },
        "limitations": { "type": "string" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["failure_mode", "example"],
        "properties": {
          "failure_mode": { "type": "string" },
          "example": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    },
    "monitoring": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "threshold", "frequency", "owner", "escalation_path"],
        "properties": {
          "metric": { "type": "string" },
          "threshold": { "type": "string" },
          "frequency": { "type": "string" },
          "owner": { "type": "string" },
          "escalation_path": { "type": "string" }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control", "type", "owner"],
        "properties": {
          "control": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["preventive", "detective", "response", "compensating"]
          },
          "owner": { "type": "string" },
          "evidence_pointer": { "type": "string" }
        }
      }
    },
    "change_management": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_type", "revalidation_trigger", "approver"],
        "properties": {
          "change_type": { "type": "string" },
          "revalidation_trigger": { "type": "string" },
          "approver": { "type": "string" }
        }
      }
    },
    "signoff_questions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["question", "section_tag"],
        "properties": {
          "question": { "type": "string" },
          "section_tag": { "type": "string", "description": "Card section the question challenges (intended_use, data, performance, limitations, monitoring, controls, change_management)." }
        }
      }
    },
    "source_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "source", "confidence"],
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string", "description": "Document, system, person, or [evidence needed]." },
          "evidence_reference": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "evidence-needed"]
          }
        }
      }
    },
    "sector_overlay_notes": {
      "type": "object",
      "description": "Sector-specific fields raised by the loaded sector overlay reference doc.",
      "properties": {
        "banking": { "type": "object", "additionalProperties": true },
        "insurance": { "type": "object", "additionalProperties": true },
        "capital_markets": { "type": "object", "additionalProperties": true },
        "payments_fintech": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
