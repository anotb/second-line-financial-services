{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-line-financial-services/schemas/board-ai-risk-pack.schema.json",
  "title": "BoardAIRiskPack",
  "description": "Wrapper for the board (or AI risk committee) AI risk pack. Consumed by the agent-plugin ai-governance-reviewer, the structured archive that supports later audit and examiner response, and the enterprise risk committee pack which pulls a brief for the AI heat-map cell.",
  "type": "object",
  "required": [
    "pack_id",
    "committee_name",
    "meeting_date",
    "period_covered",
    "classification",
    "executive_summary",
    "inventory_state",
    "top_risks",
    "incidents",
    "vendor_exposure",
    "decisions_requested",
    "data_confidence_label",
    "human_review_required"
  ],
  "additionalProperties": false,
  "properties": {
    "pack_id": {
      "type": "string",
      "description": "Stable ID for this pack instance (committee, date)."
    },
    "committee_name": {
      "type": "string",
      "description": "e.g., AI Risk Committee, Board Risk Committee (AI Section), Technology and Innovation Committee."
    },
    "meeting_date": { "type": "string", "format": "date" },
    "period_covered": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "classification": {
      "type": "string",
      "enum": ["internal", "board-confidential", "regulator-shareable"]
    },
    "scope_id": {
      "type": "string",
      "description": "Links to scoping record if supplied."
    },
    "executive_summary": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 5,
      "description": "Up to five bullets in AI Governance Lead voice. The call-outs the chair reads first."
    },
    "inventory_state": {
      "type": "object",
      "required": ["total_use_cases", "by_tier", "change_since_last"],
      "properties": {
        "total_use_cases": { "type": "integer", "minimum": 0 },
        "by_tier": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tier", "count"],
            "properties": {
              "tier": { "type": "string", "description": "Firm's tier label (e.g., tier-1 / tier-2 / tier-3 / tier-4, or low/moderate/high/critical)." },
              "count": { "type": "integer", "minimum": 0 },
              "prior_count": { "type": ["integer", "null"] }
            }
          }
        },
        "by_sector_or_business_line": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["segment", "count"],
            "properties": {
              "segment": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "by_lifecycle_stage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage", "count"],
            "properties": {
              "stage": {
                "type": "string",
                "enum": ["intake", "tiered", "validated", "pre-prod-gate", "in-prod", "retired"]
              },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "by_architecture_flag": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["flag", "count"],
            "properties": {
              "flag": {
                "type": "string",
                "enum": ["traditional-ml", "foundation-model", "rag", "agentic", "agentic-with-tool-use"]
              },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "change_since_last": {
          "type": "object",
          "required": ["new_use_cases", "tier_movements", "retirements"],
          "properties": {
            "new_use_cases": { "type": "integer", "minimum": 0 },
            "tier_movements": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["use_case_id", "from_tier", "to_tier", "rationale"],
                "properties": {
                  "use_case_id": { "type": "string" },
                  "from_tier": { "type": "string" },
                  "to_tier": { "type": "string" },
                  "rationale": { "type": "string" }
                }
              }
            },
            "retirements": { "type": "integer", "minimum": 0 }
          }
        },
        "inventory_reconciliation_status": {
          "type": "string",
          "enum": ["reconciled", "partial", "not-reconciled"],
          "description": "Reconciliation against the inventory of record. 'partial' or 'not-reconciled' constrains the data confidence label."
        }
      }
    },
    "top_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_id", "risk_name", "trajectory", "owner", "trajectory_basis"],
        "properties": {
          "risk_id": { "type": "string" },
          "risk_name": { "type": "string" },
          "trajectory": {
            "type": "string",
            "enum": ["improving", "stable", "worsening", "new"]
          },
          "trajectory_basis": {
            "type": "string",
            "description": "One-line basis for the trajectory call. 'Stable' without basis is the wallpaper failure mode."
          },
          "exposure_quantified": { "type": ["string", "null"] },
          "key_drivers": { "type": "array", "items": { "type": "string" } },
          "owner": {
            "type": "string",
            "description": "Role, never a named individual."
          },
          "linked_use_cases_or_programs": { "type": "array", "items": { "type": "string" } },
          "target_action": { "type": "string" },
          "logged_date": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Required when trajectory = 'new'."
          }
        }
      }
    },
    "in_flight_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["use_case_or_program", "stage", "decision_due_date"],
        "properties": {
          "use_case_or_program": { "type": "string" },
          "stage": {
            "type": "string",
            "enum": ["intake", "tiered", "validated", "pre-prod-gate", "in-prod", "retired"]
          },
          "decision_due_date": { "type": "string", "format": "date" },
          "second_line_recommendation": { "type": "string" },
          "committee_carry_forward_reason": { "type": ["string", "null"] }
        }
      }
    },
    "incidents": {
      "type": "object",
      "required": ["events", "near_misses_section"],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["incident_id", "incident_date", "classification", "severity", "regulator_notification_status", "owner", "status"],
            "properties": {
              "incident_id": { "type": "string" },
              "incident_date": { "type": "string", "format": "date" },
              "classification": {
                "type": "string",
                "enum": [
                  "functional-failure", "performance-breach", "fairness-exposure",
                  "data-leakage", "prompt-injection-signal", "foundation-model-version-event",
                  "rag-retrieval-failure", "agentic-tool-misuse", "vendor-outage",
                  "other"
                ]
              },
              "severity": {
                "type": "string",
                "enum": ["informational", "low", "medium", "high", "critical"]
              },
              "regulator_notification_status": {
                "type": "string",
                "enum": ["not-applicable", "evaluating", "notified", "no-notification-required-rationale-on-file"]
              },
              "customer_impact": { "type": "string" },
              "owner": { "type": "string", "description": "Role." },
              "status": {
                "type": "string",
                "enum": ["open", "under-investigation", "remediated", "closed"]
              }
            }
          }
        },
        "near_misses_section": {
          "type": "object",
          "required": ["had_near_misses_in_period"],
          "properties": {
            "had_near_misses_in_period": { "type": "boolean" },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["near_miss_id", "near_miss_date", "classification", "owner"],
                "properties": {
                  "near_miss_id": { "type": "string" },
                  "near_miss_date": { "type": "string", "format": "date" },
                  "classification": { "type": "string" },
                  "narrative": { "type": "string" },
                  "owner": { "type": "string", "description": "Role." }
                }
              }
            },
            "no_near_miss_statement": {
              "type": ["string", "null"],
              "description": "Required when had_near_misses_in_period is false. Explicit statement that no near-misses were logged this period."
            }
          }
        }
      }
    },
    "regulator_interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["regulator", "item_type", "status", "owner"],
        "properties": {
          "regulator": { "type": "string" },
          "item_type": {
            "type": "string",
            "enum": ["MRA", "MRIA", "supervisory-letter", "exam-finding", "information-request", "consent-order"]
          },
          "topic": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "in-remediation", "responded", "closed"]
          },
          "owner": { "type": "string", "description": "Role." },
          "target_close": { "type": ["string", "null"], "format": "date" },
          "slippage_commentary": {
            "type": ["string", "null"],
            "description": "Required for over-age items."
          }
        }
      }
    },
    "vendor_exposure": {
      "type": "object",
      "required": ["top_vendors", "foundation_model_concentration"],
      "properties": {
        "top_vendors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["vendor_name", "use_case_count"],
            "properties": {
              "vendor_name": { "type": "string" },
              "use_case_count": { "type": "integer", "minimum": 0 },
              "vendor_category": {
                "type": "string",
                "enum": ["foundation-model-provider", "evaluation-vendor", "rag-infrastructure", "agent-platform", "ml-platform", "other"]
              },
              "version_change_posture": {
                "type": "string",
                "enum": ["pinned", "floating", "rolling-with-notice", "unknown"]
              }
            }
          }
        },
        "foundation_model_concentration": {
          "type": "object",
          "required": ["entries"],
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["provider", "model_name", "use_case_count"],
                "properties": {
                  "provider": { "type": "string" },
                  "model_name": { "type": "string" },
                  "use_case_count": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "top_three_concentration_ratio": {
              "type": ["number", "null"],
              "description": "Share of GenAI use cases concentrated on the top three foundation models, as a fraction (0.0 to 1.0)."
            }
          }
        },
        "key_dependencies": { "type": "array", "items": { "type": "string" } },
        "watch_list": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["vendor_name", "concern"],
            "properties": {
              "vendor_name": { "type": "string" },
              "concern": {
                "type": "string",
                "enum": ["deprecation-notice", "security-incident", "regulatory-action", "quality-drift", "other"]
              },
              "narrative": { "type": "string" }
            }
          }
        }
      }
    },
    "model_performance_trends": {
      "type": "object",
      "properties": {
        "tier_1_and_tier_2_in_prod_count": { "type": "integer", "minimum": 0 },
        "red_breaches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["use_case_id", "metric", "owner", "status"],
            "properties": {
              "use_case_id": { "type": "string" },
              "metric": { "type": "string" },
              "owner": { "type": "string", "description": "Role." },
              "status": { "type": "string" }
            }
          }
        },
        "drift_signals_population_summary": { "type": "string" },
        "fairness_drift_summary": { "type": "string" },
        "genai_specific_drift_summary": { "type": "string" }
      }
    },
    "genai_program_status": {
      "type": "object",
      "properties": {
        "pipeline": {
          "type": "object",
          "properties": {
            "intake_count": { "type": "integer", "minimum": 0 },
            "in_pre_prod_gate": { "type": "integer", "minimum": 0 },
            "in_prod": { "type": "integer", "minimum": 0 },
            "retired_in_period": { "type": "integer", "minimum": 0 }
          }
        },
        "pre_prod_gate_throughput": {
          "type": "object",
          "properties": {
            "decisions_made": { "type": "integer", "minimum": 0 },
            "exceptions_granted": { "type": "integer", "minimum": 0 },
            "items_returned": { "type": "integer", "minimum": 0 },
            "exception_rationale_summary": { "type": "string" }
          }
        },
        "rag_corpora_under_governance_count": { "type": "integer", "minimum": 0 },
        "agentic_deployments_by_autonomy_level": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["autonomy_level", "count"],
            "properties": {
              "autonomy_level": {
                "type": "string",
                "enum": ["human-in-the-loop", "human-on-the-loop", "supervised-autonomy", "agentic-with-tool-use"]
              },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "genai_incident_posture_summary": { "type": "string" }
      }
    },
    "ai_governance_maturity": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["nist-ai-rmf", "iso-42001", "naic-ais-program", "eu-ai-act-deployer", "firm-bespoke", "blended"]
        },
        "narrative_summary": { "type": "string" },
        "evidence_appendix_pointer": { "type": "string" }
      }
    },
    "policy_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change", "effective_date", "owner"],
        "properties": {
          "change": { "type": "string" },
          "effective_date": { "type": "string", "format": "date" },
          "owner": { "type": "string", "description": "Role." }
        }
      }
    },
    "forward_look": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Named, dated, regulator-anchored items only. Two cycles ahead is the standard horizon."
    },
    "decisions_requested": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "decision_requested", "options", "recommended_motion", "requested_vote_or_acknowledgement", "owner"],
        "properties": {
          "decision_id": { "type": "string" },
          "decision_requested": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "recommended_motion": { "type": "string" },
          "requested_vote_or_acknowledgement": {
            "type": "string",
            "enum": ["vote-required", "acknowledgement-only", "noting-only"]
          },
          "owner": { "type": "string", "description": "Role." }
        }
      }
    },
    "source_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source", "confidence"],
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string" },
          "evidence_reference": { "type": ["string", "null"] },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "evidence-needed"]
          }
        }
      }
    },
    "data_confidence_label": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "bcbs239_known_limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known data-aggregation gaps from the firm's most recent BCBS 239 self-assessment. If non-empty or inventory_reconciliation_status is not 'reconciled', data_confidence_label cannot be 'high'."
    },
    "human_review_required": {
      "type": "boolean",
      "description": "Always true for v1."
    }
  }
}
