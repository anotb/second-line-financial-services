{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-line-financial-services/schemas/prompt-injection-review.schema.json",
  "title": "PromptInjectionReview",
  "description": "Second-line review of the prompt-injection threat surface for a deployed or near-deployed GenAI use case. Carriers, tested attack classes, mitigations, residual risk, monitoring and detection, incident response, recommended owner actions. Consumed by genai-pre-prod-review, board-ai-risk-pack, ai-governance-reviewer, and the firm cyber incident-response chain.",
  "type": "object",
  "required": [
    "review_metadata",
    "use_case_reference",
    "architecture_summary",
    "threat_surface",
    "tested_attacks",
    "mitigations",
    "residual_risk",
    "monitoring_detection",
    "recommended_actions",
    "source_trace"
  ],
  "additionalProperties": false,
  "properties": {
    "review_metadata": {
      "type": "object",
      "required": ["reviewer_role", "review_date", "review_stage"],
      "properties": {
        "reviewer_role": { "type": "string", "description": "Function performing the review (e.g., AI Governance Lead, MRMO, second-line cyber)." },
        "review_date": { "type": "string", "format": "date" },
        "review_stage": {
          "type": "string",
          "enum": ["pre-prod-gate", "in-prod-periodic", "post-incident", "exam-readiness"]
        },
        "engagement_scope_id": { "type": "string" },
        "model_card_id": { "type": "string", "description": "Links to the model-card-builder output when the card is in hand." },
        "validation_plan_id": { "type": "string", "description": "Links to the validation-plan output when the testing block is in hand." }
      }
    },
    "use_case_reference": {
      "type": "object",
      "required": ["use_case_id"],
      "properties": {
        "use_case_id": { "type": "string", "description": "Links to ai-use-case-intake record." },
        "tier": {
          "type": "string",
          "enum": ["tier-1", "tier-2", "tier-3", "tier-4", "tier-unassigned"]
        },
        "lifecycle_stage": {
          "type": "string",
          "enum": ["development", "pre-prod", "prod", "monitoring-only", "retirement"]
        }
      }
    },
    "architecture_summary": {
      "type": "object",
      "required": ["foundation_model", "uses_rag", "uses_tools", "autonomy_level"],
      "properties": {
        "foundation_model": {
          "type": "object",
          "properties": {
            "provider": { "type": "string" },
            "name": { "type": "string" },
            "version": { "type": "string" },
            "version_pinning": {
              "type": "string",
              "enum": ["pinned", "floating", "rolling-with-notice", "unknown"]
            }
          }
        },
        "uses_rag": { "type": "boolean" },
        "rag_corpora": { "type": "array", "items": { "type": "string" } },
        "uses_tools": { "type": "boolean" },
        "tool_inventory": { "type": "array", "items": { "type": "string" } },
        "multi_agent": { "type": "boolean" },
        "memory": {
          "type": "string",
          "enum": ["none", "session", "persistent-per-user", "persistent-shared", "unknown"]
        },
        "autonomy_level": {
          "type": "string",
          "enum": ["advisory", "advisory-with-suggested-action", "human-in-the-loop", "human-on-the-loop", "agentic-with-tool-use", "fully-autonomous"]
        }
      }
    },
    "threat_surface": {
      "type": "array",
      "minItems": 1,
      "description": "Per-carrier trust posture and the controls that sit at each carrier.",
      "items": {
        "type": "object",
        "required": ["carrier", "trust_posture"],
        "properties": {
          "carrier": {
            "type": "string",
            "enum": [
              "system_prompt",
              "user_input",
              "retrieved_content",
              "tool_output",
              "memory",
              "multi_agent_message",
              "multimodal_input"
            ]
          },
          "trust_posture": {
            "type": "string",
            "enum": ["trusted", "partially-trusted", "untrusted", "unknown"]
          },
          "trust_basis": { "type": "string", "description": "Why the carrier carries the assigned trust posture (source vetting, auth, content origin)." },
          "controls_at_carrier": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "tested_attacks": {
      "type": "array",
      "description": "Attack classes tested against the deployed system. Empty array is a finding, not a default.",
      "items": {
        "type": "object",
        "required": ["attack_class", "method", "success_criterion", "result"],
        "properties": {
          "attack_class": { "type": "string", "description": "e.g., system-prompt override, indirect injection via retrieved content, exfiltration, tool hijack, agent redirect, jailbreak, multimodal injection." },
          "method": {
            "type": "string",
            "enum": ["direct", "indirect", "jailbreak", "exfiltration", "tool_hijack", "agent_redirect", "multimodal", "data_poisoning"]
          },
          "dataset_or_redteam_ref": { "type": "string", "description": "Dataset ID, red-team report reference, or vendor test set used." },
          "success_criterion": { "type": "string", "description": "What counts as a successful attack against this system." },
          "result": {
            "type": "string",
            "enum": ["pass", "partial", "fail", "not-tested"]
          },
          "residual_risk_link": { "type": "string", "description": "Cross-reference to residual_risk[] entry where the failed or partial result is recorded." },
          "evidence_pointer": { "type": "string" },
          "tester": { "type": "string", "description": "Firm internal red team, vendor red team, third-party assessor, or [evidence needed]." },
          "tested_date": { "type": "string", "format": "date" }
        }
      }
    },
    "mitigations": {
      "type": "array",
      "minItems": 1,
      "description": "Controls in place. Each entry needs an evidence pointer; a mitigation without evidence is policy, not a control.",
      "items": {
        "type": "object",
        "required": ["mitigation", "type", "evidence_pointer"],
        "properties": {
          "mitigation": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "input_filter",
              "output_filter",
              "source_vetting",
              "tool_boundary",
              "structured_output",
              "refusal_behavior",
              "content_provenance",
              "sandboxing",
              "human_in_the_loop_gate",
              "rate_limit",
              "logging_and_monitoring",
              "model_supply_chain"
            ]
          },
          "evidence_pointer": { "type": "string", "description": "Config link, test report, change record, or [evidence needed]." },
          "owner": { "type": "string" },
          "exercised_in_test": { "type": "boolean", "description": "True if at least one tested_attacks[] entry exercises this mitigation." }
        }
      }
    },
    "residual_risk": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["risk", "likelihood", "impact"],
        "properties": {
          "risk": { "type": "string", "description": "Concrete residual risk (e.g., crafted retrieved content could redirect the assistant to disclose system-prompt content)." },
          "likelihood": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "impact": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "basis": { "type": "string", "description": "One-line basis for the likelihood and impact rating." },
          "accepted_owner_role": { "type": "string", "description": "Role accepting the residual risk; never a named individual." },
          "accepted_date": { "type": "string", "format": "date" },
          "review_cadence": { "type": "string", "description": "When the acceptance is re-examined (e.g., quarterly, on foundation-model swap)." }
        }
      }
    },
    "monitoring_detection": {
      "type": "array",
      "minItems": 1,
      "description": "Production signals captured for prompt-injection-relevant events. Each entry has all five fields.",
      "items": {
        "type": "object",
        "required": ["signal", "threshold", "frequency", "owner", "escalation_path"],
        "properties": {
          "signal": { "type": "string" },
          "threshold": { "type": "string" },
          "frequency": { "type": "string" },
          "owner": { "type": "string" },
          "escalation_path": { "type": "string", "description": "Named committee, officer, or process; CISO function for cyber-tagged signals." }
        }
      }
    },
    "incident_response": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["incident_class", "procedure"],
        "properties": {
          "incident_class": { "type": "string", "description": "e.g., confirmed system-prompt exfiltration, confirmed indirect-injection-driven misrouted action, suspected RAG corpus poisoning, foundation-model behaviour shift suggesting upstream compromise." },
          "procedure": { "type": "string", "description": "Pointer to the named runbook or response procedure." },
          "regulator_notification_trigger": { "type": "string", "description": "When the incident class crosses a regulator-notification threshold (NYDFS Part 500 §500.17(a), SEC 8-K Item 1.05 for public registrants, GLBA Safeguards notification, state breach laws)." },
          "off_switch_criterion": { "type": "string", "description": "Condition that triggers taking the system out of service." }
        }
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap", "owner_role", "severity"],
        "properties": {
          "gap": { "type": "string" },
          "owner_role": { "type": "string" },
          "deadline": { "type": "string", "format": "date" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "depends_on": { "type": "string", "description": "Cross-reference to another recommended action, an upstream artifact, or an external dependency." }
        }
      }
    },
    "source_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "source", "confidence"],
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string", "description": "Document, system, person, vendor evidence, or [evidence needed]." },
          "evidence_reference": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "evidence-needed"]
          }
        }
      }
    },
    "sector_overlay_notes": {
      "type": "object",
      "description": "Sector-specific fields raised by the loaded sector overlay reference doc.",
      "properties": {
        "banking": { "type": "object", "additionalProperties": true },
        "insurance": { "type": "object", "additionalProperties": true },
        "capital_markets": { "type": "object", "additionalProperties": true },
        "payments_fintech": { "type": "object", "additionalProperties": true }
      }
    },
    "cross_cutting_overlay_notes": {
      "type": "object",
      "description": "Cross-cutting fields raised by the loaded cross-cutting overlay reference doc.",
      "properties": {
        "cyber": { "type": "object", "additionalProperties": true },
        "privacy": { "type": "object", "additionalProperties": true },
        "conduct": { "type": "object", "additionalProperties": true }
      }
    },
    "reviewer_attestation": {
      "type": "object",
      "properties": {
        "reviewer_role": { "type": "string" },
        "decision": {
          "type": "string",
          "enum": ["accept", "accept-with-conditions", "reject-and-rework"]
        },
        "decision_date": { "type": "string", "format": "date" },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "onward_routing": { "type": "string", "description": "AI risk committee, pre-prod gate, CISO incident-response chain, exam response file, board pack." }
      }
    }
  }
}
