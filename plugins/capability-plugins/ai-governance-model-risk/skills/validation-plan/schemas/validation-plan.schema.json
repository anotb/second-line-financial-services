{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-line-financial-services/schemas/validation-plan.schema.json",
  "title": "ValidationPlan",
  "description": "Validator-side scope contract for an AI or model use case. For traditional models in scope at federally regulated banks the binding anchor is the joint interagency Revised Guidance on Model Risk Management (OCC 2026-13 / FRB SR 26-2 / FDIC FIL-15-2026, supersedes SR 11-7); the bulletin excludes GenAI and agentic AI from scope so for those use cases the plan anchors to NIST AI 600-1, ISO/IEC 42001, and the EU AI Act where applicable. Consumed by model-card-builder, validation-report (phase 3), and the ai-governance-reviewer agent.",
  "type": "object",
  "required": [
    "plan_metadata",
    "validation_depth",
    "conceptual_soundness",
    "data_review",
    "outcomes_analysis",
    "monitoring",
    "effective_challenge_questions",
    "source_trace"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_metadata": {
      "type": "object",
      "required": ["model_id", "version", "tier", "validator", "scope_date"],
      "additionalProperties": false,
      "properties": {
        "model_id": { "type": "string", "description": "Canonical firm model ID." },
        "version": { "type": "string" },
        "tier": {
          "type": "string",
          "enum": ["tier-1", "tier-2", "tier-3", "tier-4", "tier-unassigned"]
        },
        "validator": { "type": "string", "description": "Validator function or role; never a named individual." },
        "model_owner": { "type": "string" },
        "scope_date": { "type": "string", "format": "date" },
        "validation_type": {
          "type": "string",
          "enum": ["initial", "annual-revalidation", "vendor-swap-revalidation", "off-cycle-trigger", "post-incident"]
        },
        "use_case_id": { "type": "string", "description": "Links to ai-use-case-intake record." },
        "engagement_scope_id": { "type": "string" }
      }
    },
    "validation_depth": {
      "type": "object",
      "description": "Depth set per pillar, not as a single label. Tier drives the default; pillar-level deviations are explained.",
      "required": ["conceptual_soundness", "outcomes_analysis", "ongoing_monitoring", "tier_justification"],
      "properties": {
        "conceptual_soundness": {
          "type": "string",
          "enum": ["full", "targeted", "light-touch", "monitor-only"]
        },
        "outcomes_analysis": {
          "type": "string",
          "enum": ["full", "targeted", "light-touch", "monitor-only"]
        },
        "ongoing_monitoring": {
          "type": "string",
          "enum": ["full", "targeted", "light-touch", "monitor-only"]
        },
        "tier_justification": { "type": "string", "description": "One paragraph on why this tier and these depths." }
      }
    },
    "conceptual_soundness": {
      "type": "object",
      "required": ["scope_items", "methods"],
      "properties": {
        "scope_items": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Theory, design choices, alternatives considered, segmentation, foundation-model selection rationale where applicable."
        },
        "methods": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Document review, replication, benchmark against challenger, vendor system-card review."
        },
        "vendor_model_card_review": {
          "type": "boolean",
          "description": "Required when foundation model is third-party. Names which vendor evidence is in scope (system card, evaluation report, red-team summary)."
        },
        "vendor_evidence_in_scope": { "type": "array", "items": { "type": "string" } },
        "success_criteria": { "type": "string" }
      }
    },
    "data_review": {
      "type": "object",
      "required": ["scope_items"],
      "properties": {
        "scope_items": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Training data, evaluation data, retrieval corpora, lineage, fitness for purpose, exclusions."
        },
        "methods": { "type": "array", "items": { "type": "string" } },
        "lineage_evidence": { "type": "array", "items": { "type": "string" } },
        "exclusions_check": { "type": "array", "items": { "type": "string" } },
        "success_criteria": { "type": "string" }
      }
    },
    "outcomes_analysis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["test_name", "method", "dataset", "success_criterion", "owner"],
        "properties": {
          "test_name": { "type": "string" },
          "method": { "type": "string" },
          "dataset": { "type": "string" },
          "segment_cuts": { "type": "array", "items": { "type": "string" } },
          "success_criterion": { "type": "string" },
          "owner": { "type": "string" },
          "benchmark_against": { "type": "string", "description": "Challenger model, prior version, vendor benchmark, or external reference." }
        }
      }
    },
    "robustness_testing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attack_class", "method", "success_criterion"],
        "properties": {
          "attack_class": {
            "type": "string",
            "description": "e.g. out-of-time, stress scenario, adversarial input, prompt injection (direct), prompt injection (indirect via retrieved content), jailbreak, RAG poisoning, model extraction, tool misuse, goal hijack."
          },
          "method": { "type": "string" },
          "success_criterion": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    },
    "fairness_explainability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "method", "success_criterion"],
        "properties": {
          "dimension": { "type": "string", "description": "Protected or policy-relevant dimension; for insurance use unfair-discrimination vocabulary per state code." },
          "method": { "type": "string" },
          "success_criterion": { "type": "string" },
          "method_limitations": { "type": "string" }
        }
      }
    },
    "monitoring": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "threshold", "frequency", "owner", "escalation_path", "revalidation_trigger"],
        "properties": {
          "metric": { "type": "string" },
          "threshold": { "type": "string" },
          "frequency": { "type": "string" },
          "owner": { "type": "string" },
          "escalation_path": { "type": "string" },
          "revalidation_trigger": {
            "type": "boolean",
            "description": "Validator monitoring is what triggers re-validation, not just operational alerts. Each entry declares whether breach triggers re-validation."
          }
        }
      }
    },
    "effective_challenge_questions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["question", "design_choice_or_assumption", "expected_evidence", "owner_of_response"],
        "properties": {
          "question": { "type": "string" },
          "design_choice_or_assumption": {
            "type": "string",
            "description": "The specific design choice, assumption, or failure mode the question interrogates. 'Does the model meet policy' fails this field."
          },
          "expected_evidence": { "type": "string" },
          "owner_of_response": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Prerequisites and access needs: data extracts, environment access, vendor evidence, foundation-model card, upstream artifacts."
    },
    "timeline": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date" },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["milestone", "date"],
            "properties": {
              "milestone": { "type": "string" },
              "date": { "type": "string", "format": "date" },
              "owner": { "type": "string" }
            }
          }
        },
        "end": { "type": "string", "format": "date" },
        "deliverables": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "source", "confidence"],
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string", "description": "Document, system, person, vendor evidence, or [evidence needed]." },
          "evidence_reference": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "evidence-needed"]
          }
        }
      }
    },
    "sector_overlay_notes": {
      "type": "object",
      "description": "Sector-specific scope items raised by the loaded sector overlay reference doc.",
      "properties": {
        "banking": { "type": "object", "additionalProperties": true },
        "insurance": { "type": "object", "additionalProperties": true },
        "capital_markets": { "type": "object", "additionalProperties": true },
        "payments_fintech": { "type": "object", "additionalProperties": true }
      }
    },
    "cross_cutting_overlay_notes": {
      "type": "object",
      "properties": {
        "cyber": { "type": "object", "additionalProperties": true },
        "privacy": { "type": "object", "additionalProperties": true },
        "conduct": { "type": "object", "additionalProperties": true }
      }
    },
    "signoff": {
      "type": "object",
      "description": "Filled by the human reviewer. The skill stops at draft.",
      "properties": {
        "reviewer": { "type": "string" },
        "reviewer_function": { "type": "string" },
        "reviewer_date": { "type": "string", "format": "date" },
        "decision": {
          "type": "string",
          "enum": ["accept", "accept-with-conditions", "reject-and-rework"]
        },
        "conditions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
